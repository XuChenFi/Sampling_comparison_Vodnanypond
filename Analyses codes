count <- df %>%
  group_by(`Metod ID`, `Month`, `Latin species name`, `Sample No.`, `Pond No.`) %>%
  summarise(
    weight = sum(`W (g)`, na.rm = TRUE),
    n_total = sum(Number, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    n_total = ifelse(`Latin species name` == "None", 0, n_total),
    Event_ID = paste(`Metod ID`, `Month`, `Pond No.`, `Sample No.`, sep = "_")
  ) %>%
  filter(!is.na(n_total))

