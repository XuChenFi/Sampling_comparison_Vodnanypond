gear_order <- c("Trap", "Cast net", "Lift net", "Electrofishing")

# Calculate percentage proportion & format numeric value labels
df_percent <- df_raw %>%
  pivot_longer(
    cols = -Country,
    names_to = "Gear",
    values_to = "Value"
  ) %>%
  mutate(Gear = str_replace(Gear, "_", " ")) %>%
  group_by(Country) %>%
  mutate(Percent = Value / sum(Value) * 100) %>%
  ungroup() %>%
  mutate(
    Country = factor(Country, levels = country_order),
    Gear = factor(Gear, levels = gear_order),
    label_text = sprintf("%.2f", Percent)
  )

