# Build hist_data
hist_data <- count %>%
  group_by(`Metod ID`, `Month`, `Latin species name`) %>%
  summarise(
    n_total = sum(n_total, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    n_total = ifelse(`Latin species name` == "None", 0, n_total)
  ) %>%
  #  Fill missing months exclusively for P2 so they render on its x-axis
  group_by(`Metod ID`) %>%
  group_modify(~ if (.y$`Metod ID` == "P2") {
    complete(.x, 
             Month = factor(c("April", "May", "June", "July", "August", "October"), levels = month_order), 
             `Latin species name`, 
             fill = list(n_total = 0))
  } else {
    .x
  }) %>%
  ungroup() %>%
  #  Exclude September for PK, P1, P2, L, E (retaining September ONLY for C)
  filter(!(`Metod ID` %in% c("PK", "P1", "P2", "L", "E") & Month == "September")) %>%
  mutate(Sample_ID = paste(`Metod ID`, Month, sep = "_")) %>%
  arrange(`Metod ID`, Month)

