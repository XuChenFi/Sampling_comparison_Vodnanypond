sample_metadata <- data.frame(Event_ID = as.character(rownames(community_matrix))) %>%
  separate(Event_ID, into = c("Metod_ID", "Month", "Pond_No", "Sample_No"), sep = "_", remove = FALSE)


get_rarefaction_line <- function(sample_id, comm_matrix) {
  species_counts <- as.numeric(comm_matrix[sample_id, ])
  species_counts <- species_counts[species_counts > 0]
  total_individuals <- sum(species_counts) 
  
  if (is.na(total_individuals) || total_individuals <= 0) {
    return(NULL)
  }
  
  if (total_individuals <= 1) {
    return(data.frame(
      Event_ID = as.character(sample_id), 
      Sampling_Effort = as.numeric(total_individuals), 
      Log_Sampling_Effort = as.numeric(log(total_individuals)),
      Expected_Richness = as.numeric(length(species_counts))
    ))
  }
  
  effort_seq <- 1:total_individuals
  
  expected_s <- vegan::rarefy(species_counts, sample = effort_seq)
  
  return(data.frame(
    Event_ID = as.character(sample_id),
    Sampling_Effort = as.numeric(effort_seq),
    Log_Sampling_Effort = as.numeric(log(effort_seq)), 
    Expected_Richness = as.numeric(expected_s)
  ))
}


rarefaction_db <- lapply(rownames(community_matrix), function(id) {
  get_rarefaction_line(id, community_matrix)
}) %>% 
  compact() %>% 
  bind_rows()

