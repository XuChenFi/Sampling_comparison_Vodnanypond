df_model <- fish_by_event_sp%>%mutate(Month = case_when(
  Month == "Apr" ~ 4,
  Month == "May" ~ 5,
  Month == "Jun" ~ 6,
  Month == "Jul" ~ 7,
  Month == "Aug" ~ 8,
  Month == "Sep" ~ 9,
  Month == "Oct" ~ 10))%>%
  complete(Metod_ID, Species, Sample_No,
           fill = list(n_total = 0)) %>%
  group_by(Sample_No) %>%
  fill(Pond_No, Month, .direction = "downup") %>%
  ungroup() %>% mutate(Count = n_total+0.0001)

m1 <- glmmTMB(
  log(Count) ~ Metod_ID + Species + Sample_No + Month + (1 | Pond_No),
  data = df_model, 
  family = gaussian(link = "identity")
)

a<-summary(m1)
model_parameters(m1, ci = 0.95)
r2_nakagawa(m1, tolerance = 1e-100)
res<-emmeans::emmeans(m1, ~ Metod_ID, component="response")
summary(res)
res<-emmeans::emmeans(m1, ~ Species, component="response")
summary(res)
res<-emmeans::emmeans(m1, ~ Month, component="response")
summary(res)
res<-emmeans::emmeans(m1, ~ Sample_No, component="response")
summary(res)

