calc_rb <- function(b, a) {
  if (requireNamespace("effectsize", quietly = TRUE)) return(effectsize::rank_biserial(b, a)$r_rank_biserial)
  w <- suppressWarnings(wilcox.test(b, a, exact = FALSE)$statistic); as.numeric((2 * w) / (length(b) * length(a)) - 1)
}
get_x <- function(m) event_totals$total_catch[event_totals$Metod_ID == m]
pair_df <- combn(method_order, 2, simplify = FALSE) %>% map_dfr(function(m) {
  a <- get_x(m[1]); b <- get_x(m[2]); tibble(col = m[1], row = m[2], p_raw = suppressWarnings(wilcox.test(b, a)$p.value), r = calc_rb(b, a))
}) %>% mutate(p_adj = p.adjust(p_raw, method = "BH"))

star <- function(p) case_when(p < 0.001 ~ "***", p < 0.01 ~ "**", p < 0.05 ~ "*", TRUE ~ "ns")
