build_rep_panel <- function(ref_df, value_col, tag_lbl, title_txt, ylab_txt) {
  custom_m <- c("Stocked", month_abbr, "Harvest")
  monthly_df <- catch_monthly %>%
    transmute(Metod_ID, Month = as.character(Month), Species, value = .data[[value_col]])
  
  comb <- bind_rows(expand_grid(Metod_ID = factor(method_order, levels = method_order), ref_df), monthly_df) %>%
    mutate(Month = factor(Month, levels = custom_m)) %>%
    group_by(Metod_ID, Month) %>%
    mutate(tot_val = sum(value, na.rm = TRUE), prop = if_else(tot_val > 0, value / tot_val, 0)) %>%
    ungroup()
  
  zero_months <- comb %>% group_by(Metod_ID, Month) %>% summarise(tot_val = first(tot_val), .groups = "drop") %>% filter(tot_val == 0)
  dividers    <- comb %>% distinct(Metod_ID, Month) %>% count(Metod_ID, name = "n_x") %>% mutate(x_stock = 1.5, x_harv = n_x - 0.5)
  
  ggplot(comb %>% filter(!is.na(Species), prop > 0), aes(x = Month, y = prop, fill = Species)) +
    geom_col(color = "#1F2937", linewidth = 0.2, width = 0.82, position = "stack") +
    geom_vline(data = dividers, aes(xintercept = x_stock), linetype = "dashed", color = "#1F2937", linewidth = 0.45) +
    geom_vline(data = dividers, aes(xintercept = x_harv),  linetype = "dashed", color = "#1F2937", linewidth = 0.45) +
    geom_text(data = zero_months, aes(x = Month, y = 0.03, label = "0"), inherit.aes = FALSE, size = 2.4, color = "#6B7280", fontface = "bold") +
    facet_wrap(~ Metod_ID, scales = "free_x", ncol = 3) +
    scale_fill_manual(values = pal_species, labels = sp_abbr, name = NULL) +
    scale_y_continuous(breaks = seq(0, 1, by = 0.25), labels = label_percent(accuracy = 1), limits = c(0, 1.03), expand = expansion(mult = c(0, 0.02))) +
    labs(tag = tag_lbl, title = title_txt, x = "Sampling period", y = ylab_txt) +
    theme_nat(base_size = 9) +
    theme(
      legend.position   = "none",
      axis.text.x       = element_text(angle = 35, hjust = 1, face = "bold", size = 8.5, color = "#1F2937"),
      axis.text.y       = element_text(face = "bold", size = 8.5, color = "#1F2937"),
      axis.title        = element_text(face = "bold", size = 10, color = "#111827"),
      plot.tag          = element_text(face = "bold", size = 12, color = "#111827"),
      plot.title        = element_text(face = "bold", size = 11.5, hjust = 0, color = "#111827"),
      strip.text        = element_text(face = "bold", size = 9, color = "#111827"),
      panel.border      = element_rect(color = "#1F2937", fill = NA, linewidth = 0.55),
      panel.grid.major  = element_blank(),
      panel.grid.minor  = element_blank()
    )
}

