month_abbr   <- c("Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct")
method_order <- c("PK", "P1", "P2", "L", "E", "C")
non_target   <- c("Chondrostoma nasus", "Pelophylax esculentus", "tadpole", "Rana temporaria")

raw_ulovky <- read_xls(data_file, sheet = "ulovky") %>%
  mutate(
    `Metod ID`  = if_else(as.character(`Metod ID`) == "C", "L", as.character(`Metod ID`)),
    Metod_ID  = if_else(as.character(`Metod ID`) == "V", "C", as.character(`Metod ID`)),
    Date      = as_date(Date),
    Month     = factor(month(Date), levels = 4:10, labels = month_abbr),
    Pond_No   = factor(`Pond No.`),
    Metod_ID  = factor(Metod_ID, levels = method_order),
    Sample_No = suppressWarnings(as.numeric(`Sample No.`)),
    W_g       = suppressWarnings(as.numeric(`W (g)`)),
    SL_mm     = suppressWarnings(as.numeric(`SL (mm)`)),
    Number    = suppressWarnings(as.numeric(Number)),
    Species   = as.character(`Latin species name`)
  )

# Standardize zero-catch deployments safely
if ("Catch type" %in% names(raw_ulovky)) {
  raw_ulovky <- raw_ulovky %>%
    mutate(
      is_nocatch = tolower(as.character(`Catch type`)) == "no catch" | is.na(Species) | Species == "None",
      Number     = if_else(is_nocatch, 0, coalesce(Number, 0)),
      Species    = if_else(is_nocatch, NA_character_, Species)
    )
} else {
  raw_ulovky <- raw_ulovky %>%
    mutate(
      is_nocatch = is.na(Species) | Species == "None",
      Number     = if_else(is_nocatch, 0, coalesce(Number, 0)),
      Species    = if_else(is_nocatch, NA_character_, Species)
    )
}

raw_ulovky <- raw_ulovky %>%
  mutate(Event_ID = paste(Metod_ID, Month, Pond_No, Sample_No, sep = "_"))

sampled_grid <- raw_ulovky %>%
  filter(!is.na(Metod_ID), !is.na(Month)) %>%
  distinct(Metod_ID, Month)

deployments_per_gear <- raw_ulovky %>%
  filter(!is.na(Metod_ID), !is.na(Month)) %>%
  distinct(Event_ID, Metod_ID) %>%
  count(Metod_ID, name = "n_dep")

# Deployment-level table (1 row per replicate, includes all zeros)
event_totals <- raw_ulovky %>%
  filter(!is.na(Metod_ID), !is.na(Month)) %>%
  mutate(
    target_n = if_else(!is.na(Species) & !(Species %in% non_target), Number, 0),
    target_w = if_else(!is.na(Species) & !(Species %in% non_target), coalesce(W_g, 0), 0)
  ) %>%
  group_by(Event_ID, Date, Month, Pond_No, Metod_ID, Sample_No) %>%
  summarise(
    total_catch  = sum(target_n, na.rm = TRUE),
    total_weight = sum(target_w, na.rm = TRUE),
    richness     = n_distinct(Species[!is.na(Species) & !(Species %in% non_target) & target_n > 0]),
    .groups = "drop"
  )

fish_indiv <- raw_ulovky %>%
  filter(!is.na(Species), !(Species %in% non_target), Number > 0)

fish_by_event_sp <- fish_indiv %>%
  group_by(Event_ID, Month, Pond_No, Metod_ID, Sample_No, Species) %>%
  summarise(n_total = sum(Number, na.rm = TRUE), weight = sum(W_g, na.rm = TRUE), .groups = "drop")

catch_monthly <- fish_by_event_sp %>%
  group_by(Metod_ID, Month, Species) %>%
  summarise(n_ind = sum(n_total), w_bio = sum(weight), .groups = "drop") %>%
  right_join(sampled_grid, by = c("Metod_ID", "Month")) %>%
  mutate(n_ind = replace_na(n_ind, 0), w_bio = replace_na(w_bio, 0))

