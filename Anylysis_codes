make_cov_ellipse <- function(d, level = 0.35, n_points = 181L) {xy<-as.matrix(d[,c("MDS1","MDS2")])
xy<-xy[complete.cases(xy),,drop=F];grp<-as.character(d$Metod_ID[1])
if(nrow(xy)<3) {return(tibble(MDS1=0,MDS2=0,Metod_ID=grp))};
S<-cov(xy);
if(!all(is.finite(S))){return(tibble(MDS1=0,MDS2=0,Metod_ID=grp))};
eig<-eigen(S,symmetric=T,only.values=T)$values;tol<-max(eig)*1e-10;
if(min(eig)<=tol){return(tibble(MDS1=0,MDS2=0,Metod_ID=grp))};
R<-tryCatch(chol(S),error=function(e)NULL);
if(is.null(R)){return(tibble(MDS1=0,MDS2=0,Metod_ID=grp))};
theta<-seq(0,2*pi,length.out=n_points);unit_circle<-cbind(cos(theta),sin(theta));center<-colMeans(xy);
ellipse_xy<-sweep(unit_circle%*%R*sqrt(qchisq(level,df=2)),2,center,"+");
tibble(MDS1=ellipse_xy[,1],MDS2=ellipse_xy[,2],Metod_ID=grp)}
