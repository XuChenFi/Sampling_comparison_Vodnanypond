spec_accum_df <- map_dfr(method_order, function(m) {
  ev_ids <- event_totals %>% filter(Metod_ID == m) %>% pull(Event_ID)
  mat <- matrix(0, nrow = length(ev_ids), ncol = ncol(comm_wide), dimnames = list(ev_ids, colnames(comm_wide)))
  common <- intersect(ev_ids, rownames(comm_wide))
  if (length(common) > 0) mat[common, ] <- as.matrix(comm_wide[common, , drop = FALSE])
  sa <- vegan::specaccum(mat, method = "exact")
  tibble(Metod_ID = factor(m, levels = method_order), Effort = sa$sites, Richness = sa$richness,
         Lower = pmax(0, sa$richness - 1.96 * sa$sd), Upper = sa$richness + 1.96 * sa$sd)
})

ind_rare_df <- map_dfr(method_order, function(m) {
  sp_vec <- fish_by_event_sp %>% filter(Metod_ID == m) %>% group_by(Species) %>% summarise(n = sum(n_total), .groups = "drop") %>% pull(n)
  n_tot <- sum(sp_vec)
  if (n_tot < 2) return(NULL)
  pts <- unique(round(exp(seq(0, log(n_tot), length.out = 60))))
  pts <- pts[pts >= 1 & pts <= n_tot]
  res <- vegan::rarefy(sp_vec, sample = pts, se = TRUE)
  tibble(Metod_ID = factor(m, levels = method_order), Individuals = pts, Richness = as.numeric(res[1, ]),
         SE = as.numeric(res[2, ]), Lower = pmax(1, Richness - 1.96 * SE), Upper = pmin(6, Richness + 1.96 * SE))
})

